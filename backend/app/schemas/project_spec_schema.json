{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://alchemy.dev/schemas/project-spec/v1.0.0",
    "title": "Alchemy Project Specification",
    "description": "Canonical schema for Alchemy project specifications - the single source of truth",
    "type": "object",
    "required": [
        "version",
        "metadata",
        "project",
        "architecture",
        "implementation"
    ],
    "properties": {
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Schema version (semver)",
            "examples": [
                "1.0.0"
            ]
        },
        "metadata": {
            "type": "object",
            "required": [
                "id",
                "created",
                "lastModified"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique project identifier"
                },
                "created": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Project creation timestamp"
                },
                "lastModified": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Last modification timestamp"
                },
                "phase": {
                    "type": "string",
                    "enum": [
                        "discovery",
                        "definition",
                        "specification",
                        "complete"
                    ],
                    "description": "Current project phase"
                },
                "progress": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Completion percentage"
                }
            }
        },
        "project": {
            "type": "object",
            "required": [
                "name",
                "purpose"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Project name"
                },
                "tagline": {
                    "type": "string",
                    "description": "Short project description"
                },
                "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Core purpose and problem being solved"
                },
                "goals": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Primary project goals"
                },
                "targetAudience": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Target user personas"
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "type",
                            "description"
                        ],
                        "properties": {
                            "type": {
                                "type": "string",
                                "enum": [
                                    "technical",
                                    "business",
                                    "regulatory",
                                    "timeline",
                                    "budget",
                                    "other"
                                ]
                            },
                            "description": {
                                "type": "string"
                            }
                        }
                    },
                    "description": "Project constraints and limitations"
                },
                "assumptions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Key assumptions made during planning"
                }
            }
        },
        "requirements": {
            "type": "object",
            "properties": {
                "functional": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "id",
                            "title",
                            "description",
                            "priority"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^FR-\\d+$"
                            },
                            "title": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            },
                            "priority": {
                                "type": "string",
                                "enum": [
                                    "critical",
                                    "high",
                                    "medium",
                                    "low"
                                ]
                            },
                            "acceptanceCriteria": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "dependencies": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "pattern": "^FR-\\d+$"
                                }
                            }
                        }
                    }
                },
                "nonFunctional": {
                    "type": "object",
                    "properties": {
                        "performance": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "security": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "scalability": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "usability": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "reliability": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "architecture": {
            "type": "object",
            "required": [
                "archetype",
                "frontend",
                "backend"
            ],
            "properties": {
                "archetype": {
                    "type": "string",
                    "enum": [
                        "web-app",
                        "mobile-app",
                        "desktop-app",
                        "api-service",
                        "cli-tool",
                        "hybrid"
                    ],
                    "description": "Application archetype"
                },
                "deploymentModel": {
                    "type": "string",
                    "enum": [
                        "cloud",
                        "on-premise",
                        "hybrid",
                        "local-only"
                    ],
                    "description": "Deployment strategy"
                },
                "frontend": {
                    "type": "object",
                    "properties": {
                        "framework": {
                            "type": "string",
                            "description": "Primary frontend framework"
                        },
                        "stateManagement": {
                            "type": "string",
                            "description": "State management approach"
                        },
                        "styling": {
                            "type": "string",
                            "description": "Styling solution"
                        },
                        "pages": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "id",
                                    "name",
                                    "route"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "route": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "components": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "authentication": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        },
                        "components": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "id",
                                    "name",
                                    "type"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "layout",
                                            "feature",
                                            "ui",
                                            "utility"
                                        ]
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "props": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "name": {
                                                    "type": "string"
                                                },
                                                "type": {
                                                    "type": "string"
                                                },
                                                "required": {
                                                    "type": "boolean"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "layout": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "single-page",
                                        "multi-page",
                                        "dashboard",
                                        "split-view",
                                        "custom"
                                    ]
                                },
                                "navigation": {
                                    "type": "string",
                                    "enum": [
                                        "sidebar",
                                        "topbar",
                                        "tabs",
                                        "none"
                                    ]
                                },
                                "responsive": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                },
                "backend": {
                    "type": "object",
                    "properties": {
                        "framework": {
                            "type": "string",
                            "description": "Backend framework"
                        },
                        "language": {
                            "type": "string",
                            "description": "Programming language"
                        },
                        "architecture": {
                            "type": "string",
                            "enum": [
                                "monolith",
                                "microservices",
                                "serverless",
                                "modular"
                            ],
                            "description": "Backend architecture pattern"
                        },
                        "services": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "id",
                                    "name",
                                    "responsibility"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "responsibility": {
                                        "type": "string"
                                    },
                                    "dependencies": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "apis": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "id",
                                    "endpoint",
                                    "method"
                                ],
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "endpoint": {
                                        "type": "string"
                                    },
                                    "method": {
                                        "type": "string",
                                        "enum": [
                                            "GET",
                                            "POST",
                                            "PUT",
                                            "PATCH",
                                            "DELETE"
                                        ]
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "authentication": {
                                        "type": "boolean"
                                    },
                                    "requestSchema": {
                                        "type": "object"
                                    },
                                    "responseSchema": {
                                        "type": "object"
                                    }
                                }
                            }
                        },
                        "database": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "sql",
                                        "nosql",
                                        "graph",
                                        "key-value",
                                        "none"
                                    ]
                                },
                                "technology": {
                                    "type": "string"
                                },
                                "models": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "name": {
                                                "type": "string"
                                            },
                                            "fields": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "integration": {
                    "type": "object",
                    "properties": {
                        "apiStyle": {
                            "type": "string",
                            "enum": [
                                "REST",
                                "GraphQL",
                                "gRPC",
                                "WebSocket"
                            ]
                        },
                        "authentication": {
                            "type": "string",
                            "enum": [
                                "none",
                                "jwt",
                                "oauth",
                                "session",
                                "api-key"
                            ]
                        },
                        "externalServices": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "purpose": {
                                        "type": "string"
                                    },
                                    "required": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "technology": {
            "type": "object",
            "properties": {
                "frontend": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "backend": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "database": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "infrastructure": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "devTools": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "implementation": {
            "type": "object",
            "properties": {
                "phases": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "id",
                            "name",
                            "order"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "order": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "description": {
                                "type": "string"
                            },
                            "tasks": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string"
                                        },
                                        "title": {
                                            "type": "string"
                                        },
                                        "status": {
                                            "type": "string",
                                            "enum": [
                                                "pending",
                                                "in-progress",
                                                "completed",
                                                "blocked"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "mvpScope": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^FR-\\d+$"
                    },
                    "description": "Functional requirements included in MVP"
                }
            }
        },
        "aiUsage": {
            "type": "object",
            "properties": {
                "models": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "purpose": {
                                "type": "string"
                            },
                            "model": {
                                "type": "string"
                            }
                        }
                    }
                },
                "features": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}